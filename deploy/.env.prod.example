# Copy to deploy/.env and fill in. Never commit the real file.
DOMAIN=ristomanager.example.com
# Your GitHub user or organisation, lower case: the images are ghcr.io/<owner>/ristomanager-*
GITHUB_OWNER=d4b0mb
# cloud-latest follows the branch; sha-xxxxxxx pins an exact build (recommended for production).
IMAGE_TAG=cloud-latest
# Generate each with:  openssl rand -base64 32
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=
