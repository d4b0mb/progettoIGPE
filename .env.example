# Copy to .env to override the local development defaults.
# These are development-only credentials; production secrets never live in git.
POSTGRES_DB=ristomanager
POSTGRES_USER=ristomanager
POSTGRES_PASSWORD=ristomanager
APP_DB_PASSWORD=ristomanager_app
# At least 32 characters. Leave empty locally: a random key is generated on each start.
JWT_SECRET=
